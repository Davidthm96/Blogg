<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <title>{{ title or metadata.title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: #000; color: #b0b0b0; font-family: "Times New Roman", serif; line-height: 1.1; text-align: left; }
        
        @media (min-width: 769px) { body { padding: 25px; max-width: 650px; } h2 { font-size: 2.2rem; } }
        @media (max-width: 768px) { body { padding: 10px; width: 100%; } h2 { font-size: 28px; } }

        article { margin-bottom: 70px; }
        h2 { color: #fff; font-weight: normal; margin-bottom: 12px; line-height: 0.95; }
        img { width: 100%; height: auto; display: block; margin-bottom: 10px; pointer-events: none; }
        
        .caption { font-size: 1.1rem; margin-bottom: 5px; }
        a { color: inherit; text-decoration: underline; }

        .music-player {
    border: 1px solid #333;
    display: flex;
    align-items: center;
    padding: 10px;
    gap: 15px;
    margin-bottom: 15px;
}
.music-cover {
    width: 60px !important;
    height: 60px !important;
    margin-bottom: 0 !important;
}
.music-info {
    flex-grow: 1;
}
.music-title {
    color: #fff;
    display: block;
    font-size: 1rem;
}
.music-artist {
    font-size: 0.8rem;
    color: #888;
}
.music-controls {
    font-family: monospace;
    font-size: 1.2rem;
    cursor: pointer;
}
.spotify-wrapper {
    background-color: #000;
    line-height: 0; /* Rimuove spazi bianchi sotto l'iframe */
}
/* Questo filtro rende il player leggermente più desaturato per integrarsi meglio */
iframe[src*="spotify"] {
    filter: grayscale(0.2) contrast(1.1);
}
    </style>
</head>
<body>
    <main>
        {{ content | safe }}
    </main>
<script src="https://www.youtube.com/iframe_api"></script>
<script>
  function onYouTubeIframeAPIReady() {
    document.querySelectorAll('.custom-player').forEach(playerContainer => {
      const videoId = playerContainer.dataset.video;
      const playBtn = playerContainer.querySelector('.play-btn');
      const progressBar = playerContainer.querySelector('.progress');
      
      let player = new YT.Player(playerContainer.querySelector('.yt-hidden'), {
        height: '0', width: '0', videoId: videoId,
        playerVars: { 'controls': 0, 'showinfo': 0, 'rel': 0 },
        events: {
          'onStateChange': (event) => {
            if (event.data == YT.PlayerState.PLAYING) {
              setInterval(() => {
                let pct = (player.getCurrentTime() / player.getDuration()) * 100;
                progressBar.style.width = pct + '%';
              }, 1000);
            }
          }
        }
      });

      playBtn.addEventListener('click', () => {
        if (player.getPlayerState() == 1) { player.pauseVideo(); playBtn.innerText = '▶'; }
        else { player.playVideo(); playBtn.innerText = 'II'; }
      });
    });
  }
</script>
</body>
</html>
